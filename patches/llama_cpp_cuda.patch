 static void ggml_backend_cuda_buffer_set_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
-
     ggml_cuda_set_device(ctx->device);
+
+    // Sadece 64 KB'tan büyük BF16 model ağırlık matrislerini kendi sıkıştırma motorumuzdan geçiriyoruz
+    if (tensor->type == GGML_TYPE_BF16 && size >= 65536 && (size % 128 == 0)) {
+        const size_t sayi_adedi = size / 2;
+        const int BLOK_BOYUTU = 64;
+        const int toplam_blok = sayi_adedi / BLOK_BOYUTU;
+        const uint8_t MERKEZ = 0x79;
+
+        const uint16_t* kaynak_bf16 = (const uint16_t*) data;
+        std::vector<uint8_t> h_sikistirilmis;
+        h_sikistirilmis.reserve(sayi_adedi);
+        std::vector<uint8_t> h_alt_byteler(sayi_adedi);
+        std::vector<uint32_t> h_blok_adresleri(toplam_blok);
+
+        uint64_t bit_tamponu = 0;
+        int tampondaki_bit = 0;
+        uint32_t toplam_bit = 0;
+
+        for (int b = 0; b < toplam_blok; b++) {
+            h_blok_adresleri[b] = toplam_bit;
+            for (int i = 0; i < BLOK_BOYUTU; i++) {
+                size_t idx = b * BLOK_BOYUTU + i;
+                uint16_t val = kaynak_bf16[idx];
+                uint8_t ust = (val >> 8) & 0xFF;
+                h_alt_byteler[idx] = val & 0xFF;
+
+                uint8_t duzenli = ((ust & 0x7F) << 1) | ((ust >> 7) & 1);
+                uint8_t fark = duzenli ^ MERKEZ;
+
+                for (int kaydir = 6; kaydir >= 0; kaydir -= 2) {
+                    uint8_t ikili = (fark >> kaydir) & 0b11;
+                    uint16_t kod = (ikili == 0) ? 0b0 : (ikili == 1) ? 0b10 : (ikili == 2) ? 0b110 : 0b111;
+                    int uzunluk = (ikili == 0) ? 1 : (ikili == 1) ? 2 : 3;
+
+                    bit_tamponu = (bit_tamponu << uzunluk) | kod;
+                    tampondaki_bit += uzunluk;
+                    toplam_bit += uzunluk;
+
+                    while (tampondaki_bit >= 8) {
+                        tampondaki_bit -= 8;
+                        h_sikistirilmis.push_back((bit_tamponu >> tampondaki_bit) & 0xFF);
+                    }
+                }
+            }
+        }
+        if (tampondaki_bit > 0) {
+            h_sikistirilmis.push_back((bit_tamponu << (8 - tampondaki_bit)) & 0xFF);
+        }
+        for (int p = 0; p < 8; p++) h_sikistirilmis.push_back(0);
+
+        ozel_toplam_ham_ust += sayi_adedi;
+        ozel_toplam_sikistirilmis += h_sikistirilmis.size();
+        ozel_islenecek_katman_sayisi++;
+
+        uint8_t *d_sikistirilmis, *d_alt;
+        uint32_t *d_adresler;
+        CUDA_CHECK(cudaMallocAsync(&d_sikistirilmis, h_sikistirilmis.size(), cudaStreamPerThread));
+        CUDA_CHECK(cudaMallocAsync(&d_adresler, h_blok_adresleri.size() * sizeof(uint32_t), cudaStreamPerThread));
+        CUDA_CHECK(cudaMallocAsync(&d_alt, sayi_adedi, cudaStreamPerThread));
+
+        CUDA_CHECK(cudaMemcpyAsync(d_sikistirilmis, h_sikistirilmis.data(), h_sikistirilmis.size(), cudaMemcpyHostToDevice, cudaStreamPerThread));
+        CUDA_CHECK(cudaMemcpyAsync(d_adresler, h_blok_adresleri.data(), h_blok_adresleri.size() * sizeof(uint32_t), cudaMemcpyHostToDevice, cudaStreamPerThread));
+        CUDA_CHECK(cudaMemcpyAsync(d_alt, h_alt_byteler.data(), sayi_adedi, cudaMemcpyHostToDevice, cudaStreamPerThread));
+
+        int threads = 256;
+        int blocks = (toplam_blok + threads - 1) / threads;
+        ozel_bf16_gpu_ac_kernel<<<blocks, threads, 0, cudaStreamPerThread>>>(
+            d_sikistirilmis, d_adresler, d_alt, (uint16_t*)((char*)tensor->data + offset), toplam_blok, BLOK_BOYUTU, MERKEZ
+        );
+
+        CUDA_CHECK(cudaFreeAsync(d_sikistirilmis, cudaStreamPerThread));
+        CUDA_CHECK(cudaFreeAsync(d_adresler, cudaStreamPerThread));
+        CUDA_CHECK(cudaFreeAsync(d_alt, cudaStreamPerThread));
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+
+        if (ozel_islenecek_katman_sayisi % 50 == 0) {
+            double kazanc = (1.0 - (double)ozel_toplam_sikistirilmis / ozel_toplam_ham_ust) * 100.0;
+            fprintf(stderr, "[ZBF16-CUDA] %d Layers Compressed | Upper Plane: %.1f MB -> %.1f MB (%%%.2f Lossless Savings)\n",
+                    ozel_islenecek_katman_sayisi, ozel_toplam_ham_ust / 1048576.0, ozel_toplam_sikistirilmis / 1048576.0, kazanc);
+        }
+        return;
+    }
+
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
 }
 
